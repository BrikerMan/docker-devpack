# ── devpack/playwright ────────────────────────────────────────────
# Ubuntu + Python (via uv) + uv + Playwright system dependencies
#
# Build args:
#   UBUNTU_VERSION  22.04 | 24.04      (default 24.04)
#   PYTHON_VERSION  3.12  | 3.13       (default 3.13)
#   UV_VERSION      any uv tag         (default latest)
#   CHINA_MIRROR    true  | false      (default false)
#
# NOTE: This image only pre-installs system-level Playwright dependencies.
#       Browsers must be installed in the downstream image:
#           RUN uv run playwright install --with-deps chromium
#
#       PLAYWRIGHT_BROWSERS_PATH=/opt/playwright is pre-configured and
#       writable by the app user.
#
# Downstream example:
#   FROM devpack:playwright
#   USER root
#   COPY --chown=app:app . /code
#   USER app
#   RUN uv sync && uv run playwright install chromium
#   CMD ["uv", "run", "python", "-m", "myapp"]
# ─────────────────────────────────────────────────────────────────

ARG UV_VERSION=latest
ARG UBUNTU_VERSION=24.04
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM ubuntu:${UBUNTU_VERSION}

ARG UBUNTU_VERSION
ARG PYTHON_VERSION=3.13
ARG UV_VERSION=latest
ARG CHINA_MIRROR=false

ENV DEBIAN_FRONTEND=noninteractive \
    UV_TOOLCHAIN_DIR=/opt/uv \
    UV_COMPILE_BYTECODE=0 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/playwright \
    PYTHONIOENCODING=utf-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TERM=xterm-256color \
    COLUMNS=120 \
    LINES=50

# ── APT mirror (Aliyun) ──────────────────────────────────────────
RUN set -eux; \
    if [ "$CHINA_MIRROR" = "true" ]; then \
      if [ -f /etc/apt/sources.list ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list && \
        sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list; \
      fi; \
      if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources && \
        sed -i 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
      fi; \
    fi

# ── System dependencies (including Playwright) ───────────────────
# Note: libasound2 was renamed to libasound2t64 in Ubuntu 24.04 (t64 transition);
#       the install tries libasound2t64 first, then falls back to libasound2 for 22.04.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libatspi2.0-0 \
    libxshmfence1 \
    libvulkan1 \
    libx11-xcb1 \
    libxcb-dri3-0 \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && (apt-get install -y --no-install-recommends libasound2t64 \
        || apt-get install -y --no-install-recommends libasound2) \
    && rm -rf /var/lib/apt/lists/*

# ── uv (copied from official image) ──────────────────────────────
COPY --from=uv /uv /uvx /usr/local/bin/

# ── PyPI / uv / Playwright mirror (Aliyun) + Python install ──────
RUN set -eux; \
    if [ "$CHINA_MIRROR" = "true" ]; then \
      mkdir -p /etc/profile.d && \
      { \
        echo 'UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"'; \
        echo 'UV_EXTRA_INDEX_URL="https://pypi.org/simple/"'; \
        echo 'PIP_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/"'; \
        echo 'PIP_TRUSTED_HOST="mirrors.aliyun.com"'; \
        echo 'PLAYWRIGHT_DOWNLOAD_HOST="https://npmmirror.com/mirrors/playwright/"'; \
      } > /etc/profile.d/china-mirror.sh && \
      chmod +x /etc/profile.d/china-mirror.sh && \
      export UV_INDEX_URL="https://mirrors.aliyun.com/pypi/simple/" && \
      export UV_EXTRA_INDEX_URL="https://pypi.org/simple/" && \
      export PLAYWRIGHT_DOWNLOAD_HOST="https://npmmirror.com/mirrors/playwright/"; \
    fi; \
    uv python install ${PYTHON_VERSION}

# ── Playwright browser cache dir ─────────────────────────────────
RUN mkdir -p /opt/playwright

# ── Non-root user ────────────────────────────────────────────────
RUN groupadd -r app && \
    useradd -r -g app -d /home/app -s /bin/bash -m app && \
    mkdir -p /code /opt/uv /opt/playwright && \
    chown -R app:app /code /opt/uv /opt/playwright

WORKDIR /code

# ── Entrypoint (sources /etc/profile.d for runtime mirror env) ───
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER app

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
